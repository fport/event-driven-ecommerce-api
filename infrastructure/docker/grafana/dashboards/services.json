    },
    {
      "title": "Error Count per Service",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "http_errors_total",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Request Duration (avg ms)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
